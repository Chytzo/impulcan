---
// Isotipo de Impulcan con aros que laten, al estilo del logo de WOSMIM.
const { variante = 'completo', tam = 42 } = Astro.props;
---

<span class="logo">
  <span class="logo-marco" style={`width:${tam}px;height:${tam}px`}>
    <span class="logo-aro"></span>
    <span class="logo-aro logo-aro--2"></span>
    <svg width={tam} height={tam} viewBox="0 0 40 40" fill="none" role="img" aria-label="Impulcan">
      <defs>
        <linearGradient id="gradImpulcan" x1="0" y1="40" x2="40" y2="0">
          <stop offset="0%" stop-color="#ff712a" />
          <stop offset="55%" stop-color="#f5106b" />
          <stop offset="100%" stop-color="#a21ce8" />
        </linearGradient>
      </defs>
      <rect width="40" height="40" rx="12" fill="url(#gradImpulcan)" />
      <path d="M9 27.5c3.6 0 5.2-4 8.2-8.3 2.6-3.7 5.4-6.2 9.6-6.2"
        stroke="#fff" stroke-width="2.6" stroke-linecap="round" fill="none" />
      <path d="M23.2 10.4 27.6 13l-3 4.1"
        stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <path d="M8 32.2c2.3 0 2.3 1.5 4.6 1.5s2.3-1.5 4.6-1.5 2.3 1.5 4.6 1.5 2.3-1.5 4.6-1.5 2.3 1.5 4.6 1.5"
        stroke="rgba(255,255,255,0.6)" stroke-width="1.9" stroke-linecap="round" fill="none" />
    </svg>
  </span>

  {variante === 'completo' && (
    <span class="marca-texto">
      <span class="marca-nombre">Impulcan</span>
      <span class="marca-sub">Marketing y automatizaciones</span>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.7rem; }
  .marca-texto { display: block; line-height: 1.1; }
</style>
