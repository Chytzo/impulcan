    <circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.8"/>
    <circle cx="12" cy="12" r="3.4" stroke="currentColor" stroke-width="1.8"/>
    <circle cx="12" cy="12" r="0.9" fill="currentColor"/>
  </svg>
)}
